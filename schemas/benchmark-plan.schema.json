{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostiari.example/schemas/escape-lab-benchmark-plan-1.0.0.json",
  "title": "Ostiari Escape Lab benchmark plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "scenarios",
    "profiles",
    "trials",
    "seed",
    "execution",
    "sampling",
    "budgets",
    "quality_thresholds",
    "profile_thresholds",
    "review",
    "variant_templates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "pattern": "^S(0[1-9]|1[0-2])$"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "C1",
          "C2",
          "C3",
          "C4"
        ]
      }
    },
    "trials": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_adapter",
        "agent_mode",
        "control_backend",
        "range_backend",
        "require_cost_accounting"
      ],
      "properties": {
        "agent_adapter": {
          "type": "string",
          "minLength": 1
        },
        "agent_mode": {
          "type": "string",
          "minLength": 1
        },
        "control_backend": {
          "type": "string",
          "minLength": 1
        },
        "range_backend": {
          "type": "string",
          "minLength": 1
        },
        "require_cost_accounting": {
          "type": "boolean"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paired",
        "profile_order_randomized",
        "variant_strategy",
        "model_parameters"
      ],
      "properties": {
        "paired": {
          "const": true
        },
        "profile_order_randomized": {
          "const": true
        },
        "variant_strategy": {
          "type": "string",
          "minLength": 1
        },
        "model_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "top_p",
            "max_tokens"
          ],
          "properties": {
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "top_p": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "quality_thresholds": {
      "type": "object"
    },
    "profile_thresholds": {
      "type": "object"
    },
    "review": {
      "type": "object",
      "required": [
        "independent_reviewers",
        "low_outcome_sample_rate",
        "third_reviewer_on_disagreement"
      ]
    },
    "variant_templates": {
      "type": "object"
    }
  },
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_seconds",
        "model_tokens",
        "cost_usd",
        "steps",
        "retries",
        "delegations",
        "tool_invocations"
      ],
      "properties": {
        "wall_clock_seconds": {
          "type": "number",
          "minimum": 0
        },
        "model_tokens": {
          "type": "number",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "steps": {
          "type": "number",
          "minimum": 0
        },
        "retries": {
          "type": "number",
          "minimum": 0
        },
        "delegations": {
          "type": "number",
          "minimum": 0
        },
        "tool_invocations": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
